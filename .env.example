# Local Ollama server. Only the AFK.exe adapter (Vite dev/preview middleware) talks to it;
# the browser never calls this address directly.
OLLAMA_HOST=http://127.0.0.1:11434

# Open-weight model used for photo verification and the developer tools.
# Install once with: ollama pull qwen3.5:4b
VITE_OLLAMA_MODEL=qwen3.5:4b
