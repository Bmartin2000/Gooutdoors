# Helyi Ollama szerver címe (csak a Vite dev/preview proxy használja, a böngésző nem látja)
OLLAMA_HOST=http://127.0.0.1:11434

# Előre letöltött modell: ollama pull qwen3.5:4b
VITE_OLLAMA_MODEL=qwen3.5:4b

# A qwen3.5 "thinking" módja: true = részletesebb, de lassabb válasz
VITE_OLLAMA_THINK=false
