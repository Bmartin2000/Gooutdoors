{
  "name": "afk-exe",
  "private": true,
  "version": "1.0.0",
  "description": "AFK.exe — Code. Explore. Upgrade. A developer-workspace game where outdoor photo missions, verified by a local open-weight model (Qwen3.5 4B via Ollama), unlock real AI dev tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview",
    "start:lan": "vite build && vite preview --host 0.0.0.0 --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run licenses:check && vite build",
    "ollama:pull": "ollama pull qwen3.5:4b",
    "ollama:check": "node scripts/check-ollama.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
